VITE_API_URL=http://localhost:5000/api

# Google sign-in — optional. Leave blank to hide the Google button. See README's
# "Google sign-in setup" section. Must match the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# The deployed public URL of this client (no trailing slash) — used to build the absolute
# og:image URL in index.html so link previews (Slack, WhatsApp, iMessage, ...) resolve it.
# Leave blank in local dev; a placeholder domain is substituted at build time when unset.
VITE_SITE_URL=
