# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# For the two AES-256 keys specifically (must decode to exactly 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/family-vault
# Also used to build the absolute logo URL in outgoing emails (${CLIENT_URL}/assets/...) — the
# client app serves those images, so this must be the client's real public URL in production.
CLIENT_URL=http://localhost:5173

# JWT secrets — generate with the 48-byte command above
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FILE_TOKEN_SECRET=

# AES-256-GCM master keys — MUST be exactly 32 bytes base64 (use the 32-byte command above)
FILE_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY=

# Storage: gridfs (default, needs only MONGODB_URI) | s3 | local (dev only)
STORAGE_DRIVER=gridfs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

MAX_FILE_MB=20
ACTIVITY_RETENTION_DAYS=365

# Google sign-in — optional. Leave blank to disable (client hides the Google button, the
# /auth/google* endpoints return 501). See README's "Google sign-in setup" section.
GOOGLE_CLIENT_ID=

# Email (Gmail SMTP) — optional. Leave SMTP_HOST blank to disable (dev logs the email instead of
# sending). See README's "Email (Gmail SMTP) setup" section — SMTP_PASS is a 16-character Gmail
# APP PASSWORD (requires 2-Step Verification), never the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Family Vault <address@gmail.com>"

# Dashboard "storage used" warning threshold (MB) for the 80%/95% admin alert emails.
STORAGE_LIMIT_MB=512

# Optional. The email address that's allowed to view/edit deployment-wide settings (e.g. which
# sign-in methods the whole app accepts) at /platform-settings. Leave blank to disable that page
# entirely for everyone.
PLATFORM_OWNER_EMAIL=
